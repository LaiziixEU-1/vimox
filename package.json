{
  "name": "vimox",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --lan",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:localhost": "expo start --localhost",
    "start:test": "cross-env EXPO_PUBLIC_VIMOX_EXPO_GO_TEST=1 expo start --tunnel --clear",
    "generate:assets": "node scripts/generate-vimox-assets.js",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "7.2.2",
    "@react-navigation/native-stack": "7.14.12",
    "expo": "55.0.18",
    "expo-camera": "55.0.16",
    "expo-constants": "55.0.15",
    "expo-image-picker": "55.0.19",
    "expo-linear-gradient": "55.0.13",
    "expo-status-bar": "55.0.5",
    "firebase": "12.12.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "cross-env": "^10.1.0",
    "dotenv": "latest",
    "pngjs": "^7.0.0",
    "typescript": "latest"
  }
}
