rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validAge() {
      return request.resource.data.age is int && request.resource.data.age >= 16;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId) && validAge();
      allow update: if isSelf(userId) && (!("age" in request.resource.data) || validAge());
      allow delete: if false;
    }

    match /waitingUsers/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isSelf(userId);
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 700;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.reporterId;
      allow read, update, delete: if false;
    }
  }
}

