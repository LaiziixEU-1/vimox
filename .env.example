# Copie ce fichier en « .env » (jamais commité) puis remplis les valeurs.
# Firebase : console Firebase > Paramètres du projet > Tes applications
EXPO_PUBLIC_FIREBASE_API_KEY=ta_cle_api
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ton-projet.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ton-projet
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ton-projet.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:ios:abcdef

# Recherche de GIF (developers.giphy.com) : sans cette clé, le bouton GIF affiche une erreur
EXPO_PUBLIC_GIPHY_API_KEY=ta_cle_giphy


# --- Éditeur de l'application (apparaît dans les textes légaux) : À REMPLIR avant la publication ---
EXPO_PUBLIC_EDITOR_NAME=
EXPO_PUBLIC_EDITOR_ADDRESS=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_EMAIL=
EXPO_PUBLIC_GOVERNING_LAW=

# --- Appels audio/vidéo : serveur Jitsi (laisse vide pour utiliser le serveur public meet.jit.si) ---
# Le serveur public peut demander une connexion Google/GitHub et limite l'usage commercial.
# Pour une vraie publication : ton propre serveur Jitsi, ex. https://appels.tondomaine.com
EXPO_PUBLIC_CALL_SERVER=

# --- Abonnement Vim+ (RevenueCat) : voir ACTIVER-LES-PAIEMENTS.md ---
# Clés PUBLIQUES du SDK (RevenueCat > Project settings > API keys). Sans elles : mode démonstration.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Nom de l'entitlement créé dans RevenueCat (laisse « premium » si tu as gardé ce nom)
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
# ⚠️ La clé SECRÈTE RevenueCat (sk_…) ne va JAMAIS ici : elle va dans les secrets Firebase (voir le guide).

# --- Publicités (Google AdMob) : voir GAGNER-DE-L-ARGENT.md ---
# Identifiants des APPLICATIONS (AdMob > Applications > Paramètres de l'application), avec un « ~ »
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
# Identifiants des BLOCS D'ANNONCES « Interstitiel » (un pour iPhone, un pour Android), avec un « / »
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_ANDROID=

# --- Match (chat aléatoire avec des inconnus, réservé aux 18 ans et plus) ---
# Mets « false » puis refais un build pour retirer Match de l'app (voir FICHE-STORES.md)
EXPO_PUBLIC_MATCH_ENABLED=true
